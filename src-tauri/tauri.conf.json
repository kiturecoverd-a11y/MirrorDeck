{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MirrorDeck",
  "version": "0.1.0",
  "identifier": "com.mirrordeck.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MirrorDeck",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Android device management & screen mirroring",
    "longDescription": "MirrorDeck is a premium Android device management and screen mirroring desktop application powered by the official Nova engine."
  }
}
